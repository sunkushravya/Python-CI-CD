
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Python') {
            steps {
                bat '"C:/Users/RAKESH/AppData/Local/Programs/Python/Python310/python.exe" --version'
            }
        }

        stage('Compile') {
            steps {
                bat '"C:/Users/RAKESH/AppData/Local/Programs/Python/Python310/python.exe" -m py_compile app.py'
            }
        }

        stage('Test') {
            steps {
                bat '"C:/Users/RAKESH/AppData/Local/Programs/Python/Python310/python.exe" -m unittest -v test_app'
            }
        }

        stage('Run Application') {
            steps {
                bat '"C:/Users/RAKESH/AppData/Local/Programs/Python/Python310/python.exe" app.py'
            }
        }
    }

    post {
        success {
            echo 'Build Successfully Completed!'
        }
        failure {
            echo 'Build Failed!'
        }
    }
}
